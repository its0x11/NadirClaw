# NadirClaw example configuration
# Copy this file to `.env`, then uncomment only the settings you want to override.
# Every variable below is intentionally commented out.

# ---------------------------------------------------------------------------
# Runtime Paths
# ---------------------------------------------------------------------------

# Base NadirClaw home directory.
# Default: ~/.nadirclaw
# NADIRCLAW_HOME=~/.nadirclaw

# Legacy alias for NADIRCLAW_HOME.
# Default: ~/.nadirclaw
# NADIRCLAW_INSTALL_DIR=~/.nadirclaw

# OpenClaw home directory for credential/config fallbacks.
# Default: ~/.openclaw
# OPENCLAW_HOME=~/.openclaw

# Additional tool home directories used for credential discovery.
# Defaults: ~/.gemini, ~/.codex, ~/.continue, ~/.cursor
# GEMINI_HOME=~/.gemini
# CODEX_HOME=~/.codex
# CONTINUE_HOME=~/.continue
# CURSOR_HOME=~/.cursor


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port to listen on.
# Default: 8856
# NADIRCLAW_PORT=8856

# Optional bearer token for local API auth.
# Default: disabled
# NADIRCLAW_AUTH_TOKEN=change-me

# Optional JSON file with user auth config.
# Default: built-in local auth behavior
# NADIRCLAW_USERS_FILE=~/.nadirclaw/users.json

# Custom log directory.
# Default: ~/.nadirclaw/logs
# NADIRCLAW_LOG_DIR=~/.nadirclaw/logs

# Log full raw requests/responses to request logs.
# Default: false
# NADIRCLAW_LOG_RAW=false

# Console logging mode.
# Values: auto, true, false
# Default: auto
# NADIRCLAW_LOG_TO_CONSOLE=auto


# ---------------------------------------------------------------------------
# Log Rotation / Retention
# ---------------------------------------------------------------------------

# Rotated server log size limit in bytes.
# Default: 52428800 (50 MB)
# NADIRCLAW_LOG_MAX_BYTES=52428800

# Number of compressed server log backups to keep.
# Default: 10
# NADIRCLAW_LOG_BACKUP_COUNT=10

# Rotated request JSONL size limit in bytes.
# Default: 104857600 (100 MB)
# NADIRCLAW_REQUEST_LOG_MAX_BYTES=104857600

# Number of compressed request JSONL backups to keep.
# Default: 20
# NADIRCLAW_REQUEST_LOG_BACKUP_COUNT=20

# Size threshold for unmanaged legacy logs like launch-agent stdout/stderr.
# Default: 209715200 (200 MB)
# NADIRCLAW_LEGACY_LOG_MAX_BYTES=209715200

# Number of compressed legacy log backups to keep.
# Default: 10
# NADIRCLAW_LEGACY_LOG_BACKUP_COUNT=10


# ---------------------------------------------------------------------------
# Core Routing Models
# ---------------------------------------------------------------------------

# Default simple-tier model.
# Default: last model in NADIRCLAW_MODELS, else gemini-3-flash-preview
# NADIRCLAW_SIMPLE_MODEL=gemini-3-flash-preview

# Default complex-tier model.
# Default: first model in NADIRCLAW_MODELS, else openai-codex/gpt-5.3-codex
# NADIRCLAW_COMPLEX_MODEL=openai-codex/gpt-5.3-codex

# Optional mid-tier model.
# Default: SIMPLE_MODEL
# NADIRCLAW_MID_MODEL=gemini-2.5-flash

# Optional reasoning-tier model.
# Default: COMPLEX_MODEL
# NADIRCLAW_REASONING_MODEL=o3

# Optional free-tier model.
# Default: SIMPLE_MODEL
# NADIRCLAW_FREE_MODEL=ollama/llama3.1:8b

# Optional orchestrator-tier model for agentic/tool-heavy workloads.
# Default: COMPLEX_MODEL
# NADIRCLAW_ORCHESTRATOR_MODEL=openai-codex/gpt-5.4

# Optional specialized coding-tier model.
# Default: COMPLEX_MODEL
# NADIRCLAW_CODING_MODEL=openai-codex/gpt-5.3-codex

# Optional specialized math-tier model.
# Default: COMPLEX_MODEL
# NADIRCLAW_MATH_MODEL=o3

# Optional specialized planning-tier model.
# Default: COMPLEX_MODEL
# NADIRCLAW_PLANNING_MODEL=openai-codex/gpt-5.4

# Optional abliterated-tier model.
# Default: SIMPLE_MODEL
# NADIRCLAW_ABLITERATED_MODEL=gemini-3-flash-preview

# Legacy ordered model list.
# Used only when explicit tier vars are not set.
# Default: openai-codex/gpt-5.3-codex,gemini-3-flash-preview
# NADIRCLAW_MODELS=openai-codex/gpt-5.3-codex,gemini-3-flash-preview


# ---------------------------------------------------------------------------
# Routing Behavior
# ---------------------------------------------------------------------------

# Binary classifier threshold.
# Lower values route more prompts to premium models.
# Default: 0.06
# NADIRCLAW_CONFIDENCE_THRESHOLD=0.06

# Optional 3-tier thresholds as simple_max,complex_min.
# Default: 0.35,0.65
# NADIRCLAW_TIER_THRESHOLDS=0.35,0.65

# Global fallback chain used when a selected model fails.
# Default: deduplicated list of orchestrator, complex, mid, simple, reasoning, free,
# coding, math, planning, abliterated
# NADIRCLAW_FALLBACK_CHAIN=openai-codex/gpt-5.4,claude-sonnet-4-5-20250929,gemini-2.5-flash

# Per-tier fallback chains override the global chain for that tier.
# NADIRCLAW_SIMPLE_FALLBACK=gemini-2.5-flash,gemini-3-flash-preview
# NADIRCLAW_MID_FALLBACK=gpt-4.1-mini,gemini-2.5-flash
# NADIRCLAW_COMPLEX_FALLBACK=claude-sonnet-4-5-20250929,gpt-4.1
# NADIRCLAW_REASONING_FALLBACK=o3,gpt-4.1
# NADIRCLAW_FREE_FALLBACK=ollama/llama3.1:8b,gemini-3-flash-preview
# NADIRCLAW_ORCHESTRATOR_FALLBACK=openai-codex/gpt-5.4,claude-sonnet-4-5-20250929,gpt-4.1
# NADIRCLAW_CODING_FALLBACK=openai-codex/gpt-5.3-codex,gemini-3-flash-preview
# NADIRCLAW_MATH_FALLBACK=o3,gemini-3-flash-preview
# NADIRCLAW_PLANNING_FALLBACK=openai-codex/gpt-5.4,gemini-3-flash-preview
# NADIRCLAW_ABLITERATED_FALLBACK=gemini-3-flash-preview,openai-codex/gpt-5.3-codex


# ---------------------------------------------------------------------------
# Provider Base URLs / Local Providers
# ---------------------------------------------------------------------------

# Ollama API endpoint.
# Default: http://localhost:11434
# OLLAMA_API_BASE=http://localhost:11434

# Custom OpenAI-compatible API base for LiteLLM-routed providers.
# Default: unset
# NADIRCLAW_API_BASE=https://example-openai-compatible.local/v1


# ---------------------------------------------------------------------------
# Provider Credentials
# ---------------------------------------------------------------------------

# Anthropic API key.
# ANTHROPIC_API_KEY=sk-ant-example

# OpenAI API key.
# Also used as the primary env var for the openai-codex provider.
# OPENAI_API_KEY=sk-example

# Google / Gemini API keys.
# NadirClaw checks GEMINI_API_KEY first, then GOOGLE_API_KEY in settings,
# and credential lookup also supports GOOGLE_API_KEY with GEMINI_API_KEY as fallback.
# GEMINI_API_KEY=AIzaExampleGeminiKey
# GOOGLE_API_KEY=AIzaExampleGoogleKey

# DeepSeek API key.
# DEEPSEEK_API_KEY=sk-deepseek-example

# Cohere API key.
# COHERE_API_KEY=example-cohere-key

# Mistral API key.
# MISTRAL_API_KEY=example-mistral-key


# ---------------------------------------------------------------------------
# OAuth / Provider Setup Helpers
# ---------------------------------------------------------------------------

# Custom Antigravity OAuth client for OpenAI ChatGPT/Codex-style login.
# NADIRCLAW_ANTIGRAVITY_CLIENT_ID=example-client-id
# NADIRCLAW_ANTIGRAVITY_CLIENT_SECRET=example-client-secret

# Custom Gemini OAuth client.
# NADIRCLAW_GEMINI_OAUTH_CLIENT_ID=example-google-oauth-client-id.apps.googleusercontent.com
# NADIRCLAW_GEMINI_OAUTH_CLIENT_SECRET=example-google-oauth-client-secret

# Optional Google Cloud project hints for Gemini OAuth / Vertex contexts.
# GOOGLE_CLOUD_PROJECT=example-project
# GOOGLE_CLOUD_PROJECT_ID=example-project


# ---------------------------------------------------------------------------
# Request Caching
# ---------------------------------------------------------------------------

# Enable prompt cache.
# Default: true
# NADIRCLAW_CACHE_ENABLED=true

# Cache TTL in seconds.
# Default: 300
# NADIRCLAW_CACHE_TTL=300

# Max in-memory cache entries.
# Default: 1000
# NADIRCLAW_CACHE_MAX_SIZE=1000


# ---------------------------------------------------------------------------
# Per-Model Rate Limits
# ---------------------------------------------------------------------------

# Per-model requests/minute limits.
# Format: model=rpm,model2=rpm2
# Default: unset
# NADIRCLAW_MODEL_RATE_LIMITS=openai-codex/gpt-5.4=20,gemini-3-flash-preview=60

# Default requests/minute limit for models without an explicit entry.
# 0 means unlimited.
# Default: 0
# NADIRCLAW_DEFAULT_MODEL_RPM=0


# ---------------------------------------------------------------------------
# Context Optimization
# ---------------------------------------------------------------------------

# Context optimization mode.
# Values: off, safe, aggressive
# Default: off
# NADIRCLAW_OPTIMIZE=off

# Maximum turns to keep when trimming conversations.
# Default: 40
# NADIRCLAW_OPTIMIZE_MAX_TURNS=40


# ---------------------------------------------------------------------------
# Budgeting / Alerts
# ---------------------------------------------------------------------------

# Daily budget in USD.
# Default: unset
# NADIRCLAW_DAILY_BUDGET=5.00

# Monthly budget in USD.
# Default: unset
# NADIRCLAW_MONTHLY_BUDGET=50.00

# Alert threshold as a fraction of budget.
# Default: 0.8
# NADIRCLAW_BUDGET_WARN_THRESHOLD=0.8

# Optional webhook URL for budget alerts.
# Default: unset
# NADIRCLAW_BUDGET_WEBHOOK_URL=https://example.invalid/webhook

# Also print budget alerts to stdout.
# Default: false
# NADIRCLAW_BUDGET_STDOUT_ALERTS=false


# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------

# OpenTelemetry OTLP endpoint.
# Default: unset
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

